<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_asset_tree_inherit_last_journal" model="ir.ui.view">
        <field name="name">account.asset.list.inherit.last.journal</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="total_posted_depreciation_value" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
