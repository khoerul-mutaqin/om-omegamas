<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit external_layout_standard -->
        <template id="external_layout_standard_inherit" inherit_id="web.external_layout_standard">
            <xpath expr="//div[contains(@class, 'footer') or contains(@t-attf-class, 'footer')]//div[contains(@class, 'o_footer_content') or contains(@t-attf-class, 'o_footer_content')]" position="inside">
                <div style="text-align: left; font-size: 11px; margin-top: -18px;">Printed on: <t t-esc="(datetime.datetime.now() + datetime.timedelta(hours=7)).strftime('%H:%M:%S - %Y-%m-%d')"/></div>
            </xpath>
        </template>

