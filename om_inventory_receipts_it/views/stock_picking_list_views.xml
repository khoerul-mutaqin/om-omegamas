<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stock_picking_list_inherit" model="ir.ui.view">
            <field name="name">stock.picking.list.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.vpicktree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="sale_id"  optional="hide"/>
                    <field name="client_order_ref"  optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='scheduled_date']" position="attributes">
                    <attribute name="widget">datetime</attribute>
                </xpath>
            </field>
        </record>

        <!-- Inherit Search View -->
        <record id="stock_picking_search_inherit" model="ir.ui.view">
            <field name="name">stock.picking.search.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_internal_search"/>
            <field name="arch" type="xml">

                <!-- Tambahkan field di bagian pencarian umum -->
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="sale_id"/>
                    <field name="client_order_ref"/>
                </xpath>

                <!-- Tambahkan filter khusus untuk SO & PO -->
                <xpath expr="//filter[@name='delivery']" position="after">
                    <filter name="sales_order" string="Sales Order" domain="[('sale_id', '!=', False)]"/>
                    <filter name="client_order_ref" string="Client Order Ref" domain="[('client_order_ref', '!=', False)]"/>
                </xpath>

                <!-- Tambahkan opsi Group By -->
                <xpath expr="//group[@expand='0']" position="inside">
                    <filter string="Sales Order" name="group_by_sale_id" domain="[]" context="{'group_by': 'sale_id'}"/>
                    <filter string="Customer Reference" name="group_by_client_ref" domain="[]" context="{'group_by': 'client_order_ref'}"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>