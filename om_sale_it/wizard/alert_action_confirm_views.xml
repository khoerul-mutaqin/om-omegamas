<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_alert_action_confirm_wizard" model="ir.ui.view">
            <field name="name">alert.action.confirm.wizard.form</field>
            <field name="model">sale.order.alert.action.confirm</field>
            <field name="arch" type="xml">
                <form string="Konfirmasi Order">
                    <group>
                         <img src="/om_manufacture_order_it/static/src/p_dietmar.jpg" alt="Deskripsi GIF" style="width: 100%;"/>
                        <span style="font-weight: bold; font-size: 20px;">
                            Apakah Anda yakin ingin mengonfirmasi oder ini?
                            <br/>
                            <b style="color: red;">⚠ Pastikan Semua data sudah benar: Tanggal, Produk dan Quantity harus sesuai!</b>
                        </span>
                    </group>
                    <footer>
                        <button string="✅ Lanjutkan" type="object" name="action_confirm" class="btn-primary"/>
                        <button string="❌ Batal" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="alert_confirm_action_wizard" model="ir.actions.act_window">
            <field name="name">Konfirmasi Order</field>
            <field name="res_model">sale.order.alert.action.confirm</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>