<odoo>
    <record id="view_export_klaim_selected_wizard_form" model="ir.ui.view">
        <field name="name">export.klaim.selected.wizard.form</field>
        <field name="model">export.klaim.selected.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Klaim Terpilih">
                <sheet>
                    <group>
                        <field name="klaim_ids" widget="many2many_tags" options="{'no_create': True}" />
                    </group>
                    <footer>
                        <button name="action_export_selected" string="Export Terpilih" type="object" class="btn-primary"/>
                        <button string="Batal" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_export_klaim_selected_wizard" model="ir.actions.act_window">
        <field name="name">Export Klaim Terpilih</field>
        <field name="res_model">export.klaim.selected.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_export_klaim_selected_wizard_form"/>
    </record>
</odoo>
