<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_confirm_mark_done_wizard" model="ir.ui.view">
        <field name="name">confirm.mark.done.wizard.form</field>
        <field name="model">mrp.confirm.mark.done.wizard</field>
        <field name="arch" type="xml">
            <form string="Konfirmasi Produksi!">
                <group>
                     <img src="/om_manufacture_order_it/static/src/konfirmasi.jpeg" alt="Deskripsi GIF" style="width: 100%;"/>
                    <span style="font-weight: bold; font-size: 20px;">
                        Apakah Anda yakin ingin Melanjutkan?
                        <br/>
                        <b style="color: red;">⚠ Pastikan semua data sudah benar! Karena data yang sudah di produce tidak bisa dirubah!</b>
                    </span>
                </group>
                <footer>
                    <button string="✅ Lanjutkan" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="❌ Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_confirm_mark_done_wizard" model="ir.actions.act_window">
        <field name="name">Konfirmasi Produksi</field>
        <field name="res_model">mrp.confirm.mark.done.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>