<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_purchase_order_privacy_inherit" model="ir.ui.view">
            <field name="name">purchase.order.form.privacy.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']" position="attributes">
                    <attribute name="readonly">state in ('purchase', 'done', 'cancel')</attribute>
                    <attribute name="create">state not in ('purchase', 'done', 'cancel')</attribute>
                    <attribute name="delete">state not in ('purchase', 'done', 'cancel')</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
