<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_custom_valuation" model="ir.ui.view">
        <field name="name">stock.picking.form.custom.valuation</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Tidak perlu modifikasi view untuk sekarang -->
            <xpath expr="." position="attributes">
                <attribute name="class">o_custom_valuation</attribute>
            </xpath>
        </field>
    </record>
</odoo>