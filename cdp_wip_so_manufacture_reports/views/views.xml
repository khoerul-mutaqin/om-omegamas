<odoo>
    <data>
        <record id="cdp_wip_so_manufacture_inherit_picking_report" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit.valuation</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="cdp_open_report_valuation" 
                            string="Open Report Valuation" 
                            type="object" 
                            class="oe_highlight"/>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="cdp_report_valuation_view_list">
            <field name="name">cdp.report.valuation.list</field>
            <field name="model">cdp.report.valuation</field>
            <field name="arch" type="xml">
                <list string="Valuation Report">
                    <field name="product_id" width="300px"/>
                    <field name="product_uom_qty" string="Qty" width="100px" optional="hide" />
                    <field name="currency_id" column_invisible="True"/> 
                    <field name="price_unit" 
                           widget="monetary" 
                           options="{'currency_field': 'currency_id'}" 
                           width="150px" 
                           sum="Total Price"/>
                    <field name="name" optional="hide"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="cdp_report_valuation_view_form">
            <field name="name">cdp.report.valuation.form</field>
            <field name="model">cdp.report.valuation</field>
            <field name="arch" type="xml">
               <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="product_id" string="Product Valuation"/>
                            <h1>
                                <field name="product_id" readonly="1" options="{'no_open': True}"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <!-- <field name="lot_ids" widget="many2many_tags"/> -->
                                <!-- <field name="product_uom_qty" string="Quantity Consumed"/> -->
                                <field name="currency_id" invisible="1"/> 
                                <field name="price_unit" widget="monetary" options="{'currency_field': 'currency_id'}"/>           
                                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                                <field name="name" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Products/Materials" name="lines">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="product_id"/>
                                        <field name="lot_producing_id"/>
                                        <field name="product_uom_qty" />
                                        <field name="currency_id" column_invisible="True"/>
                                        <field name="price_unit" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Priceunit Qty"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="cdp_report_valuation_action">
            <field name="name">Valuation Report</field>
            <field name="res_model">cdp.report.valuation</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>