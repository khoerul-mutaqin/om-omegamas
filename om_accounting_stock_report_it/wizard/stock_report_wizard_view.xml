<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_report_wizard_form" model="ir.ui.view">
        <field name="name">stock.report.wizard.form</field>
        <field name="model">stock.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Stock Movement and Value Report">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Select a date range to view stock movements and values.
                        Leave products and categories empty to include all items.
                    </div>
                    <group>
                        <group>
                            <field name="date_from" 
                                   required="1"
                                   help="Start date for the report period"/>
                            <field name="date_to" 
                                   required="1"
                                   help="End date for the report period"/>
                        </group>
                        <group>
                            <field name="product_ids" 
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   help="Leave empty to include all products"/>
                            <field name="category_ids" 
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   help="Leave empty to include all categories"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_confirm" 
                                string="Generate Report" 
                                type="object" 
                                class="btn-primary" 
                                data-hotkey="q"/>
                        <button string="Cancel" 
                                class="btn-secondary" 
                                special="cancel" 
                                data-hotkey="z"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stock_report_wizard" model="ir.actions.act_window">
        <field name="name">Stock Movement and Value Report</field>
        <field name="res_model">stock.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_stock_report_wizard_form"/>
    </record>

    <menuitem id="menu_stock_report_wizard"
              name="Stock Movement and Value Report"
              parent="stock.menu_warehouse_report"
              action="action_stock_report_wizard"
              sequence="100"/>
</odoo>
