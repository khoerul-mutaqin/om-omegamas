<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sequences for account asset -->
        <record id="cdp_wip_lot_product" model="ir.sequence">
            <field name="name">LOT WIP Product</field>
            <field name="code">cdp.wip.lot.product</field>
            <field name="prefix">PWIP-%(range_y)s.</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="cdp_wip_mo_sequence" model="ir.sequence">
            <field name="name">WIP MO Shadow</field>
            <field name="code">cdp.wip.mrp.production</field>
            <field name="prefix">STRG/PBP/SDW/%(y)s/%(month)s/%(day)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
