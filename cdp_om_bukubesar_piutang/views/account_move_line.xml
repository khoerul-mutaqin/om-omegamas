<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aml_view_search_inherit" model="ir.ui.view">
        <field name="name">account.move.line.search.inherit</field>
        <field name="model">account.move.line</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter"/>
        <field name="arch" type="xml">
            <filter name="unposted" position="after">
                <!--PIUTANG-->
                <filter string="PIUTANG" name="piutang" domain="[('parent_state', '=', 'posted')]" help="Posted Journal Items"/>
                <filter string="UTANG" name="utang" domain="[('move_id.move_type', '=', 'in_invoice')]" help="Posted Journal Items"/>
            </filter>
        </field>
    </record>
    
    <record id="cdp_account_move_form" model="ir.ui.view">
        <field name="name">account.move.line.inherit.Form</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <form edit="0" create="0">
                <sheet>
                    <group>
                        <group>
                <field name="x_saldo_piutang" />
                <field name="x_akhir" optional="show" />
                <field name="x_month" optional="show" />
                <field name="x_year" optional="show" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- https://www.falinwa.com/odoo/my-tickets/12067 -->
    <!-- PIUTANG -->
    <record id="sml_form_inherit_piutang" model="ir.ui.view">
        <field name="name">account.move.line.inherit.Piutang</field>
        <field name="model">account.move.line</field>
        <!-- <field name="inherit_id" ref="account.view_pos_pos_form"/> -->
        <field name="arch" type="xml">
            <list name="move_line_tree" string="PIUTANG">
                <!--<list name="move_line_tree" string="PIUTANG" create="false" edit="true" expand="context.get('expand', False)" multi_edit="1" sample="1">-->
                <field name="move_id" optional="show" string="INVOICE" />
                <field name="partner_id" optional="show" readonly="move_type != 'entry'" />
                <field name="product_id" optional="show" />      
                <field name="company_currency_id" />
                <!--<field name="x_total_return"/>-->
                <field name="x_saldo_awal_piutang" optional="show" string="Saldo Awal" />
                <field name="x_amount_total" optional="show" string="Faktur Penjualan" />
                <field name="x_studio_penerimaan_penjualan" string="Penerimaan Penjualan" optional="show" readonly="move_type != 'entry'" />
                <field name="x_return_piutang" />
                <!--belum sesuai-->
                <field name="x_uang_muka_piutang" />
                <field name="x_bukti_jurnal_piutang" />
                <field name="x_saldo_piutang" />
                <field name="x_akhir" optional="hide" />
                <field name="x_month" optional="hide" />
                <field name="x_year" optional="hide" />
            </list>
        </field>
    </record>

    <!-- https://www.falinwa.com/odoo/my-tickets/12068 -->
    <!-- UTANG -->
    <record id="sml_form_inherit_utang" model="ir.ui.view">
        <field name="name">account.move.line.inherit.utang</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list name="move_line_tree" string="UTANG">
                <field name="move_id" optional="show" string="INVOICE" />
                <field name="partner_id" optional="show" readonly="move_type != 'entry'" />
                <field name="product_id" optional="show" />                
                <field name="company_currency_id" />
                <field name="x_saldo_awal_utang" />
                <field name="x_faktur_pembelian_utang" />
                <field name="x_pembayaran_pemasok_utang" />
                <field name="x_return_pembelian_utang" />
                <field name="x_uang_muka_utang" />
                <field name="x_bukti_jurnal_utang" />
                <field name="x_saldo_utang" />
                <field name="x_akhir" optional="hide" />
                <field name="x_month" optional="hide" />
                <field name="x_year" optional="hide" />
            </list>
        </field>
    </record>
    <!-- Action action_piutang_om -->
    <record id="action_piutang_om" model="ir.actions.act_window">
        <field name="name">Ringkasan Buku Besar Piutang</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'journal_type':'general', 'search_default_piutang':1}</field>
        <!-- <field name="domain">[('display_type', 'not in', ('line_section', 'line_note')), ('parent_state', '!=', 'cancel'), ("partner_id", "!=", False)]</field> -->
        <field name="view_ids" eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'list', 'view_id': ref('sml_form_inherit_piutang')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('cdp_account_move_form')})]" />
        
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There are no lines yet. Click here to create a new .
            </p>
        </field>
    </record>
    <!-- Action action_utang_om -->
    <record id="action_utang_om" model="ir.actions.act_window">
        <field name="name">Search View Ringkasan Buku Besar utang</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'journal_type':'general', 'search_default_utang':1}</field>
        <!-- <field name="domain">[('display_type', 'not in', ('line_section', 'line_note')), ('parent_state', '!=', 'cancel'), ("partner_id", "!=", False)]</field> -->
        <field name="view_ids" eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'list', 'view_id': ref('sml_form_inherit_piutang')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('cdp_account_move_form')})]" />
        
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There are no lines yet. Click here to create a new .
            </p>
        </field>
    </record>

    <!-- Search action_utang_om -->
    

    <menuitem id="cdp_piutang" name="Reporting: Ringkasan Buku Besar Piutang" parent="account.account_reports_legal_statements_menu" action="action_piutang_om" sequence="50" />
    <menuitem id="cdp_utang" name="Reporting: Ringkasan Buku Besar Utang" parent="account.account_reports_legal_statements_menu" action="action_utang_om" sequence="55" />

</odoo>