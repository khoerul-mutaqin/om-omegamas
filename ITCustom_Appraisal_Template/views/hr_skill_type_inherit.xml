<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the hr.skill.type form to add kepemimpinan field -->
    <record id="hr_skill_type_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.skill.type.form.inherit</field>
        <field name="model">hr.skill.type</field>
        <field name="inherit_id" ref="hr_skills.hr_employee_skill_type_view_form"/>
        <field name="arch" type="xml">
            <!-- Add bobot_nilai field with label after the name field -->
            <xpath expr="//field[@name='name']" position="after">
                <label for="bobot_nilai" string="Bobot Nilai"/>
                <div>
                    <field name="bobot_nilai" class="oe_inline"/>
                    <span class="oe_inline">%</span>
                </div>
            </xpath>
            
            <!-- Add definisi field to the skills list view -->
            <xpath expr="//field[@name='skill_ids']/list/field[@name='name']" position="after">
                <field name="definisi"/>
            </xpath>
        </field>
    </record>
</odoo>
