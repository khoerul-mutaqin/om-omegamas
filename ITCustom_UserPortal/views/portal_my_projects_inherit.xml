<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <template id="portal_my_projects_inherit" name="Inherit My Projects" inherit_id="project.portal_my_projects">
        <!-- Replace table with card layout -->
        <xpath expr="//t[@t-call='portal.portal_table']" position="replace">
            <div class="row project-cards-container">
                <t t-foreach="projects" t-as="project">
                    <div class="col-md-4 col-sm-6 mb-3">
                        <div class="card project-card h-100" t-attf-onclick="window.location.href='/my/projects/#{project.id}'" style="cursor:pointer;">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">
                                    <span class="project-link card-link">
                                        <span t-field="project.name"/>
                                    </span>
                                </h5>
                                <p class="card-text mt-auto">
                                    <span class="badge bg-primary task-count">
                                        <t t-out="project.task_count"/> <t t-out="project.label_tasks"/>
                                    </span>
                                </p>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </xpath>
    </template>

    <template id="portal_tasks_list_inherit" name="Inherit Tasks List for Kanban" inherit_id="project.portal_tasks_list">
        <!-- Replace table with Kanban columns -->
        <xpath expr="//t[@t-call='portal.portal_table']" position="replace">
            <div class="kanban-container">
                <div class="kanban-board row">
                    <t t-foreach="grouped_tasks" t-as="tasks">
                        <div class="kanban-column col-md-3 mb-3">
                            <div class="kanban-column-header">
                                <h5 class="kanban-column-title">
                                    <t t-if="groupby == 'stage_id'">
                                        <span t-field="tasks[0].sudo().stage_id.name"/>
                                    </t>
                                    <t t-elif="groupby == 'priority'">
                                        <span t-field="tasks[0].sudo().priority"/>
                                    </t>
                                    <t t-elif="groupby == 'state'">
                                        <span t-field="tasks[0].sudo().state"/>
                                    </t>
                                    <t t-elif="groupby == 'project_id'">
                                        <span t-if="tasks[0].sudo().project_id" t-field="tasks[0].sudo().project_id.name"/>
                                        <span t-else="">No Project</span>
                                    </t>
                                    <t t-else="">
                                        <t t-esc="groupby"/>
                                    </t>
                                </h5>
                                <span class="badge bg-secondary task-count-badge">
                                    <t t-out="len(tasks)"/>
                                </span>
                            </div>
                            <div class="kanban-column-content">
                                <t t-foreach="tasks" t-as="task">
                                    <div class="kanban-card card mb-2" t-attf-onclick="window.location.href='/my/tasks/#{task.id}'" style="cursor:pointer;">
                                        <div class="card-body p-3">
                                            <h6 class="card-title mb-2">
                                                <span t-field="task.name"/>
                                            </h6>
                                            <div class="task-meta">
                                                <small class="text-muted">
                                                    #<span t-esc="task.id"/>
                                                </small>
                                                <t t-if="task.user_ids">
                                                    <div class="assignees mt-1">
                                                        <img class="rounded-circle assignee-avatar" t-attf-src="#{image_data_uri(task.sudo().user_ids[:1].avatar_128)}" alt="Assignee" style="width: 20px; height: 20px;"/>
                                                        <span t-if="len(task.user_ids) > 1" class="badge ms-1">+<t t-out="len(task.user_ids) - 1"/></span>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
